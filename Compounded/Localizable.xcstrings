    "DEF" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفكرة من العائد المركب هو انك تحقق ربح اضافي عن طريق استثمار ارباحك السابقة بالاضافة الى ربحك من استثمار رأس المال، يعني ببساطة انك تقوم بأعادة استثمار ارباحك حتى تحقق عوائد عليها ايضا و تكرر ذلك كل سنة حتى تتراكم الارباح."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is the interest on a loan or deposit calculated based on both the initial principal and the accumulated interest from previous periods. \n \nbasically when you earn interest on both the money you've saved and the interest you earn."
          }
        }
      }
    },
    "Definition" : {
